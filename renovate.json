{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^CMakeLists\\.txt\\.in$/"],
      "matchStrings": [
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>google/googletest)\\.git\\s+GIT_TAG\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Update the clang-format version shared by local formatting and CI.",
      "managerFilePatterns": ["/^apply-clang\\.sh$/"],
      "matchStrings": [
        "uvx\\s+--from\\s+clang-format==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "clang-format",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
