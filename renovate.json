{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^CMakeLists\\.txt\\.in$/"],
      "matchStrings": [
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>google/googletest)\\.git\\s+GIT_TAG\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
